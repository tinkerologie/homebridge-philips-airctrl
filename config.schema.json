{
  "pluginAlias": "PhilipsAirPurifier",
  "pluginType": "platform",
  "singular": true,
  "customUi": true,
  "customUiPath": "./homebridge-ui",
  "headerDisplay": "Philips air purifiers and supported fans over encrypted CoAP. Scan for devices below — no JSON editing required.",
  "schema": {
    "type": "object",
    "properties": {
      "name": {
        "title": "Platform Name",
        "type": "string",
        "default": "Philips Air Purifier",
        "required": true
      },
      "devices": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "host": {
              "title": "IP Address",
              "type": "string",
              "required": true
            },
            "name": {
              "title": "Name",
              "type": "string"
            },
            "model": {
              "title": "Model",
              "type": "string"
            },
            "port": {
              "title": "CoAP Port",
              "type": "integer",
              "minimum": 1,
              "maximum": 65535,
              "default": 5683
            },
            "exposeLight": {
              "title": "Expose display light",
              "type": "boolean",
              "default": true
            },
            "exposeSleepSwitch": {
              "title": "Expose Sleep switch",
              "type": "boolean",
              "default": false
            },
            "exposeNaturalSwitch": {
              "title": "Expose Natural Breeze switch",
              "type": "boolean",
              "default": false
            },
            "exposeAutoPlusSwitch": {
              "title": "Expose Auto+ AI switch",
              "type": "boolean",
              "default": false
            },
            "exposeBeepSwitch": {
              "title": "Expose Beep switch",
              "type": "boolean",
              "default": false
            }
          }
        }
      }
    }
  }
}
