{
  "name": "homebridge-philips-airctrl",
  "displayName": "Philips Air Purifier",
  "version": "0.2.1",
  "description": "HomeKit support for Philips air purifiers over encrypted CoAP, with no Python dependency.",
  "author": "Ruaan Deysel",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tinkerologie/homebridge-philips-airctrl.git"
  },
  "bugs": {
    "url": "https://github.com/tinkerologie/homebridge-philips-airctrl/issues"
  },
  "homepage": "https://github.com/tinkerologie/homebridge-philips-airctrl#readme",
  "engines": {
    "homebridge": "^2.0.0",
    "node": "^22.12.0 || ^24.0.0"
  },
  "keywords": [
    "homebridge-plugin",
    "supports-hap",
    "philips",
    "air-purifier",
    "airpurifier",
    "coap"
  ],
  "files": [
    "dist",
    "config.schema.json",
    "homebridge-ui",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.test.json",
    "lint": "eslint . --max-warnings=0 && npm run typecheck",
    "prepublishOnly": "npm run lint && npm run test && npm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@homebridge/plugin-ui-utils": "^2.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "^10.8.0",
    "globals": "^17.8.0",
    "homebridge": "^2.2.1",
    "prettier": "3.9.10",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  }
}
